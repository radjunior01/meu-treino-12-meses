function importarBackup(event){

const arquivo=
event.target.files[0];

if(!arquivo)
return;


const leitor=
new FileReader();


leitor.onload=function(e){

try{

const backup=
JSON.parse(e.target.result);


if(
!backup.dados
){

throw new Error(
"Arquivo inválido"
);

}


/* BACKUP DO ESTADO ATUAL */

criarBackupInterno(
"Antes de importar backup"
);


const confirmar=
confirm(
