<!DOCTYPE html>
<html lang="pt-BR">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<meta name="theme-color" content="#111827">
<title>Meu Treino V4</title>

<style>
*{box-sizing:border-box}
body{
 margin:0;
 font-family:Arial,Helvetica,sans-serif;
 background:#f1f5f9;
 color:#111827
}
header{
 background:#111827;
 color:#fff;
 padding:20px 18px;
 position:sticky;
 top:0;
 z-index:10
}
header h1{margin:0;font-size:24px}
header p{margin:6px 0 0;color:#cbd5e1;font-size:13px}
main{max-width:760px;margin:auto;padding:15px 14px 100px}
.card{
 background:#fff;
 border-radius:18px;
 padding:18px;
 margin-bottom:14px;
 box-shadow:0 4px 15px rgba(0,0,0,.06)
}
.row{
 display:flex;
 justify-content:space-between;
 align-items:center;
 gap:10px
}
.muted{color:#64748b;font-size:13px;line-height:1.5}
.small{font-size:11px}
.badge{
 background:#e5e7eb;
 padding:6px 10px;
 border-radius:20px;
 font-size:11px
}
.grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:10px
}
.stat{
 background:#f8fafc;
 border-radius:14px;
 padding:14px
}
.stat span{font-size:12px;color:#64748b}
.stat strong{display:block;font-size:21px;margin-top:5px}
.progress{
 height:10px;
 background:#e5e7eb;
 border-radius:20px;
 overflow:hidden;
 margin:14px 0
}
.progress-bar{
 height:100%;
 background:#111827;
 width:0%;
 transition:.3s
}
button{
 border:0;
 border-radius:12px;
 padding:12px 15px;
 background:#111827;
 color:#fff;
 font-weight:bold;
 cursor:pointer;
 font-size:14px
}
button.green{background:#166534}
button.secondary{background:#e5e7eb;color:#111827}
button.red{background:#991b1b}
button.blue{background:#1d4ed8}
button:disabled{opacity:.45;cursor:not-allowed}
input,select{
 width:100%;
 padding:11px;
 border:1px solid #cbd5e1;
 border-radius:10px;
 font-size:14px;
 background:#fff
}
.inputs{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px;
 margin-top:10px
}
.day-grid{
 display:grid;
 grid-template-columns:repeat(7,1fr);
 gap:6px;
 margin-top:12px
}
.day{
 border:1px solid #cbd5e1;
 border-radius:10px;
 padding:9px 4px;
 text-align:center;
 font-size:11px;
 cursor:pointer;
 background:#fff
}
.day.selected{
 background:#111827;
 color:#fff;
 border-color:#111827
}
.day small{display:block;margin-top:4px;opacity:.7}
.preview{
 border-top:1px solid #e5e7eb;
 padding:13px 0
}
.preview:first-child{border-top:0}
.week-title{font-weight:bold;margin-bottom:8px}
.week-days{
 display:grid;
 grid-template-columns:repeat(7,1fr);
 gap:4px
}
.week-day{
 background:#f8fafc;
 border-radius:8px;
 padding:8px 3px;
 text-align:center;
 font-size:10px
}
.week-day strong{
 display:block;
 font-size:12px;
 margin-top:4px
}
.week-day.a{background:#e5e7eb}
.week-day.b{background:#dbeafe}
.week-day.rest{color:#94a3b8}
.phase{
 border-left:5px solid #111827;
 padding-left:12px
}
.exercise{
 padding:16px 0;
 border-top:1px solid #e5e7eb
}
.exercise:first-child{border-top:0}
.exercise-name{font-weight:bold;font-size:16px}
.exercise-info{
 font-size:13px;
 color:#64748b;
 margin-top:5px
}
.exercise-note{
 font-size:12px;
 color:#475569;
 margin-top:8px;
 line-height:1.45
}
.series{
 margin-top:10px;
 padding:10px;
 background:#f8fafc;
 border-radius:10px
}
.series-title{
 font-size:12px;
 font-weight:bold;
 margin-bottom:6px
}
.history{
 padding:12px 0;
 border-top:1px solid #e5e7eb
}
.history:first-child{border-top:0}
.history-exercise{
 padding:8px 0;
 font-size:12px
}
.hidden{display:none!important}
nav{
 position:fixed;
 bottom:0;
 left:0;
 right:0;
 background:#fff;
 border-top:1px solid #e5e7eb;
 display:flex;
 justify-content:center;
 gap:5px;
 padding:9px;
 z-index:20
}
nav button{
 background:transparent;
 color:#64748b;
 font-size:12px;
 padding:9px 12px
}
nav button.active{
 background:#111827;
 color:#fff
}
.warning{
 background:#fff7ed;
 border:1px solid #fed7aa;
 border-radius:12px;
 padding:12px;
 font-size:12px;
 line-height:1.5
}
.success{
 background:#f0fdf4;
 border:1px solid #bbf7d0;
 border-radius:12px;
 padding:12px;
 font-size:12px
}
.danger{
 background:#fef2f2;
 border:1px solid #fecaca;
 border-radius:12px;
 padding:12px;
 font-size:12px;
 line-height:1.5
}
.security{
 background:#eff6ff;
 border:1px solid #bfdbfe;
 border-radius:12px;
 padding:12px;
 font-size:12px;
 line-height:1.5
}
.divider{
 border:0;
 border-top:1px solid #e5e7eb;
 margin:18px 0
}
.button-grid{
 display:grid;
 grid-template-columns:1fr 1fr;
 gap:8px
}
.center{text-align:center}
.version{
 display:inline-block;
 background:#1e293b;
 color:#cbd5e1;
 border-radius:20px;
 padding:4px 9px;
 font-size:10px;
 margin-top:8px
}
</style>
</head>

<body>

<header>
<h1>💪 Meu Treino</h1>
<p>Plano de hipertrofia • 52 semanas • V4</p>
<span class="version">🛡️ Dados protegidos</span>
</header>

<main>

<!-- ================= INÍCIO ================= -->

<section id="inicio">

<div class="card">

<div class="row">
<div>
<strong>Status do plano</strong>
<div class="muted" id="statusPlano">Planejamento</div>
</div>
<span class="badge" id="semanaBadge">Sem data</span>
</div>

<div id="planejamento">

<p class="muted">
Escolha quando pretende começar e quais dias da semana serão seus treinos.
</p>

<label class="small">📅 Data de início</label>
<br><br>

<input type="date" id="dataPlanejamento">

<br><br>

<strong>🗓️ Dias de treino</strong>
<p class="muted">Escolha exatamente 3 dias.</p>

<div class="day-grid" id="seletorDias"></div>

<p class="muted" id="contadorDias">
0 de 3 dias selecionados
</p>

</div>

</div>


<!-- SEGURANÇA -->

<div class="card">

<div class="security">

<strong>🛡️ Proteção contra acidentes</strong>

<p>
Seu histórico de treinos fica separado do planejamento.
Alterar ou iniciar um novo plano <strong>não apaga seus treinos anteriores</strong>.
</p>

<div class="muted" id="statusBackup">
Backup interno: verificando...
</div>

</div>

</div>


<!-- PRÉVIA -->

<div class="card">

<div class="row">
<strong>👀 Prévia do calendário</strong>
<span class="badge">Simulação</span>
</div>

<p class="muted">
Veja como ficará a sequência A/B.
</p>

<div id="previewCalendario">
<p class="muted">
Escolha a data e os 3 dias de treino para visualizar.
</p>
</div>

</div>


<!-- INICIAR -->

<div class="card" id="cardConfirmacao">

<strong>🚀 Plano</strong>

<p class="muted">
Ao iniciar, apenas o planejamento atual será alterado.
Seu histórico anterior será preservado.
</p>

<button class="green" onclick="iniciarPlanoOficial()">
🟢 Iniciar plano oficialmente
</button>

</div>


<!-- PLANO ATIVO -->

<div class="card hidden" id="cardAtivo">

<div class="row">

<div>
<strong id="faseNome">-</strong>
<div class="muted" id="focoFase">-</div>
</div>

<span class="badge" id="esforco">-</span>

</div>

<div class="progress">
<div class="progress-bar" id="barra"></div>
</div>

<div class="grid">

<div class="stat">
<span>Semana</span>
<strong id="semanaAtual">-</strong>
</div>

<div class="stat">
<span>Treinos concluídos</span>
<strong id="totalTreinosInicio">0</strong>
</div>

</div>

</div>


<!-- FASE -->

<div class="card hidden" id="cardFase">

<div class="phase">

<strong id="faseTitulo">-</strong>

<p class="muted" id="faseDescricao">-</p>

<p class="small" id="faseObservacao">-</p>

</div>

</div>


<!-- HOJE -->

<div class="card hidden" id="cardHoje">

<div class="row">

<div>
<strong id="tituloHoje">Hoje</strong>
<div class="muted" id="subtituloHoje">-</div>
</div>

<span class="badge" id="badgeHoje">-</span>

</div>

<p class="muted" id="orientacaoHoje">-</p>

<button onclick="abrirTreinoAtual()">
Abrir treino →
</button>

</div>


<!-- ESTATÍSTICAS -->

<div class="card">

<div class="grid">

<div class="stat">
<span>🏋️ Treinos</span>
<strong id="totalTreinos">0</strong>
</div>

<div class="stat">
<span>⚖️ Peso atual</span>
<strong id="pesoAtual">-- kg</strong>
</div>

</div>

</div>

</section>


<!-- ================= TREINO ================= -->

<section id="treino" class="hidden">

<div class="card">

<div class="row">

<div>
<strong id="treinoTitulo">Treino</strong>
<div class="muted" id="treinoSubtitulo">-</div>
</div>

<span class="badge" id="treinoBadge">-</span>

</div>

<div id="listaExercicios"></div>

<div class="warning">
💡 <strong>Antes de concluir:</strong>
confira se as séries realizadas estão registradas.
</div>

<br>

<button class="green" onclick="concluirTreino()">
✓ Concluir treino
</button>

</div>

</section>


<!-- ================= PROGRESSO ================= -->

<section id="progresso" class="hidden">

<div class="card">

<strong>⚖️ Registrar peso</strong>

<p class="muted">
Acompanhe sua evolução corporal.
</p>

<div class="inputs">

<input
type="number"
id="campoPeso"
placeholder="Peso em kg"
step="0.1"
>

<button onclick="salvarPeso()">
Salvar
</button>

</div>

<div id="historicoPeso"></div>

</div>


<div class="card">

<strong>📊 Resumo</strong>

<div class="grid">

<div class="stat">
<span>Treinos</span>
<strong id="totalTreinos2">0</strong>
</div>

<div class="stat">
<span>Plano atual</span>
<strong id="progressoPercentual">0%</strong>
</div>

</div>

<p class="muted">
Semana <strong id="progressoSemana">-</strong>
</p>

</div>


<!-- HISTÓRICO -->

<div class="card">

<div class="row">

<strong>📚 Histórico de treinos</strong>

<span class="badge" id="historicoQuantidade">0</span>

</div>

<div id="historicoTreinos">
<p class="muted">
Nenhum treino concluído ainda.
</p>
</div>

</div>


<!-- BACKUP -->

<div class="card">

<strong>🛡️ Cofre de dados</strong>

<p class="muted">
Seus dados possuem backups internos automáticos.
Você também pode exportar uma cópia para o celular.
</p>

<div class="success">
<strong>Estado atual</strong>
<div id="resumoSeguranca">Carregando...</div>
</div>

<br>

<div class="button-grid">

<button onclick="exportarBackup()">
⬇️ Exportar JSON
</button>

<button class="blue" onclick="mostrarBackups()">
🛡️ Backups internos
</button>

</div>

<br>

<label class="small">
Restaurar arquivo JSON externo
</label>

<br><br>

<input
type="file"
id="arquivoBackup"
accept=".json"
onchange="importarBackup(event)"
>

<div id="areaBackups"></div>

</div>


<!-- NOVO CICLO -->

<div class="card">

<strong>🔄 Novo ciclo de treino</strong>

<p class="muted">
Você pode iniciar um novo planejamento sem apagar o histórico.
</p>

<div class="danger">
⚠️ O histórico de treinos <strong>não será apagado</strong>.
Somente o planejamento atual será substituído.
</div>

<br>

<button class="secondary" onclick="prepararNovoCiclo()">
🔄 Preparar novo ciclo
</button>

</div>

</section>

</main>


<!-- ================= MENU ================= -->

<nav>

<button
id="menuInicio"
class="active"
onclick="abrirTela('inicio')">
🏠 Início
</button>

<button
id="menuTreino"
onclick="abrirTela('treino')">
🏋️ Treino
</button>

<button
id="menuProgresso"
onclick="abrirTela('progresso')">
📈 Progresso
</button>

</nav>


<script>

/* =====================================================
VERSÃO / CHAVE
===================================================== */

const VERSAO="V4";

const CHAVE_DADOS="meuTreino12MesesV4";

const CHAVE_BACKUPS="meuTreinoBackupsV4";


/* =====================================================
TREINO A
===================================================== */

const treinoA=[

{
nome:"Leg press",
series:3,
reps:"8–12",
descanso:"2 min",
nota:"Ao fazer 12 reps nas 3 séries com boa técnica, aumente um pouco a carga."
},

{
nome:"Supino máquina ou barra",
series:3,
reps:"8–12",
descanso:"2 min",
nota:"Aumente gradualmente mantendo boa técnica."
},

{
nome:"Remada baixa",
series:3,
reps:"8–12",
descanso:"2 min",
nota:"Movimento controlado, sem puxar com o corpo."
},

{
nome:"Elevação lateral",
series:3,
reps:"12–15",
descanso:"60–90 s",
nota:"Aumente a carga mantendo controle."
},

{
nome:"Mesa flexora",
series:2,
reps:"10–15",
descanso:"90 s",
nota:"Controle a volta do movimento."
},

{
nome:"Rosca bíceps",
series:2,
reps:"10–15",
descanso:"60–90 s",
nota:"Evite balançar o tronco."
},

{
nome:"Tríceps na polia",
series:2,
reps:"10–15",
descanso:"60–90 s",
nota:"Movimento controlado."
}

];


/* =====================================================
TREINO B
===================================================== */

const treinoB=[

{
nome:"Agachamento guiado ou leg press",
series:3,
reps:"8–12",
descanso:"2 min",
nota:"Priorize técnica e amplitude confortável."
},

{
nome:"Supino inclinado",
series:3,
reps:"8–12",
descanso:"2 min",
nota:"Controle a descida."
},

{
nome:"Puxada alta",
series:3,
reps:"8–12",
descanso:"2 min",
nota:"Puxe em direção ao alto do peito."
},

{
nome:"Desenvolvimento de ombros máquina",
series:2,
reps:"8–12",
descanso:"2 min",
nota:"Movimento controlado."
},

{
nome:"Cadeira extensora",
series:2,
reps:"10–15",
descanso:"90 s",
nota:"Controle subida e descida."
},

{
nome:"Rosca bíceps",
series:2,
reps:"10–15",
descanso:"60–90 s",
nota:"Sem balanço."
},

{
nome:"Tríceps na polia",
series:2,
reps:"10–15",
descanso:"60–90 s",
nota:"Controle o movimento."
}

];


/* =====================================================
FASES
===================================================== */

const fases=[

{
inicio:1,
fim:4,
nome:"Adaptação",
esforco:"Leve–moderado",
foco:"Aprender técnica e rotina",
observacao:"Termine as séries sentindo que conseguiria mais 3–4 repetições."
},

{
inicio:5,
fim:12,
nome:"Construção 1",
esforco:"Moderado",
foco:"Aumentar gradualmente cargas/reps",
observacao:"Chegue perto da falha sem precisar falhar em todas as séries."
},

{
inicio:13,
fim:24,
nome:"Construção 2",
esforco:"Moderado–alto",
foco:"Consistência e progressão",
observacao:"Registre cargas e repetições."
},

{
inicio:25,
fim:36,
nome:"Construção 3",
esforco:"Moderado–alto",
foco:"Consolidar técnica e volume",
observacao:"Reavalie medidas e fotos."
},

{
inicio:37,
fim:52,
nome:"Construção 4",
esforco:"Moderado–alto",
foco:"Ganhar músculo mantendo cintura controlada",
observacao:"Ajuste alimentação conforme evolução."
}

];


const nomesDias=[
"Dom",
"Seg",
"Ter",
"Qua",
"Qui",
"Sex",
"Sáb"
];


/* =====================================================
ESTRUTURA NOVA DE DADOS
===================================================== */

function dadosVazios(){

return {

versao:V4,

plano:{

dataInicio:null,

diasTreino:[],

proximoTreino:"A"

},

historico:{

treinos:[],

peso:[]

},

cargas:{},

criadoEm:new Date().toISOString(),

atualizadoEm:new Date().toISOString()

};

}


/* =====================================================
CARREGAMENTO SEGURO
===================================================== */

function carregarDados(){

try{

const bruto=
localStorage.getItem(CHAVE_DADOS);

if(!bruto){

return dadosVazios();

}

const salvo=
JSON.parse(bruto);

const base=
dadosVazios();

return {

...base,

...salvo,

plano:{
...base.plano,
...(salvo.plano||{})
},

historico:{
...base.historico,
...(salvo.historico||{})
},

cargas:{
...(salvo.cargas||{})
}

};

}catch(e){

alert(
"⚠️ Os dados principais parecem corrompidos. Foi criado um novo espaço seguro."
);

return dadosVazios();

}

}


let dados=carregarDados();

let diasSelecionados=[
...(dados.plano.diasTreino||[])
];

let treinoEmEdicao=null;


/* =====================================================
FUNÇÕES COMPATIBILIDADE
===================================================== */

function quantidadeTreinos(){

return dados.historico.treinos.length;

}


function atualizarTimestamp(){

dados.atualizadoEm=
new Date().toISOString();

}


/* =====================================================
BACKUP INTERNO
===================================================== */

function criarBackupInterno(motivo){

try{

const lista=
JSON.parse(
localStorage.getItem(CHAVE_BACKUPS)
)||[];

const copia=
JSON.parse(
JSON.stringify(dados)
);

lista.push({

id:Date.now(),

motivo:motivo,

data:new Date().toISOString(),

dados:copia

});

while(lista.length>5){

lista.shift();

}

localStorage.setItem(
CHAVE_BACKUPS,
JSON.stringify(lista)
);

}catch(e){

console.warn(
"Não foi possível criar backup interno.",
e
);

}

}


/* =====================================================
SALVAR
===================================================== */

function salvar(motivo="Alteração de dados"){

atualizarTimestamp();

criarBackupInterno(motivo);

try{

localStorage.setItem(
CHAVE_DADOS,
JSON.stringify(dados)
);

}catch(e){

alert(
"⚠️ Não foi possível salvar os dados no navegador."
);

}

atualizarStatusSeguranca();

}


/* =====================================================
SALVAR SEM CRIAR BACKUP
===================================================== */

function salvarSilencioso(){

atualizarTimestamp();

localStorage.setItem(
CHAVE_DADOS,
JSON.stringify(dados)
);

}


/* =====================================================
DATA
===================================================== */

function obterDataPlanejamento(){

const campo=
document.getElementById(
"dataPlanejamento"
);

if(!campo.value){

return null;

}

return new Date(
campo.value+"T00:00:00"
);

}


/* =====================================================
SELETOR
===================================================== */

function criarSeletorDias(){

const area=
document.getElementById(
"seletorDias"
);

area.innerHTML="";

for(let i=0;i<7;i++){

const div=
document.createElement("div");

div.className="day";

if(
diasSelecionados.includes(i)
){

div.classList.add("selected");

}

div.innerHTML=
`
${nomesDias[i]}
<small>
${diasSelecionados.includes(i)?"✓":""}
</small>
`;

div.onclick=function(){

if(
diasSelecionados.includes(i)
){

diasSelecionados=
diasSelecionados.filter(
d=>d!==i
);

}else{

if(
diasSelecionados.length>=3
){

alert(
"Escolha exatamente 3 dias."
);

return;

}

diasSelecionados.push(i);

}

diasSelecionados.sort(
(a,b)=>a-b
);

document.getElementById(
"contadorDias"
).textContent=
diasSelecionados.length+
" de 3 dias selecionados";

criarSeletorDias();

atualizarPlanejamento();

};

area.appendChild(div);

}

document.getElementById(
"contadorDias"
).textContent=
diasSelecionados.length+
" de 3 dias selecionados";

}


/* =====================================================
TREINO NA SEMANA
===================================================== */

function treinoNaSemana(
semana,
dia
){

if(
!diasSelecionados.includes(dia)
){

return "Descanso";

}

const posicao=
diasSelecionados.indexOf(dia);

if(
semana%2===1
){

return posicao%2===0
?
"A"
:
"B";

}

return posicao%2===0
?
"B"
:
"A";

}


/* =====================================================
PRÉVIA
===================================================== */

function atualizarPlanejamento(){

const data=
obterDataPlanejamento();

const area=
document.getElementById(
"previewCalendario"
);

if(
!data ||
diasSelecionados.length!==3
){

area.innerHTML=
`
<p class="muted">
Escolha a data e os 3 dias de treino para visualizar.
</p>
`;

return;

}

area.innerHTML="";

for(
let semana=1;
semana<=8;
semana++
){

const inicio=
new Date(data);

inicio.setDate(
