"Restaurar este arquivo substituirá os dados atuais pelos dados do arquivo.\n\n"+
"Deseja continuar?"
);


if(!confirmar){

event.target.value="";

return;

}


const recebido=backup.dados;


/* NORMALIZAÇÃO */

dados={

...dadosVazios(),

...recebido,

plano:{
...dadosVazios().plano,
...(recebido.plano||{})
},

historico:{
...dadosVazios().historico,
...(recebido.historico||{})
},

cargas:{
...(recebido.cargas||{})
}

};


salvarSilencioso();


alert(
"Backup restaurado com sucesso! 🔐\n\n"+
"Faça uma conferência do histórico."
);


location.reload();


}catch(erro){

alert(
"❌ Não foi possível restaurar este arquivo.\n\n"+
"Ele pode não ser um backup válido da V4."
);

}

};


leitor.readAsText(arquivo);

}


