/* =====================================================
SEMANA
===================================================== */

function calcularSemana(){

if(
!dados.plano.dataInicio
){

return null;

}

const inicio=
new Date(
dados.plano.dataInicio+"T00:00:00"
);

const hoje=
new Date();

const diferenca=
hoje.getTime()-
inicio.getTime();

const dias=
Math.floor(
diferenca/
(1000*60*60*24)
);

if(dias<0)
return 1;

let semana=
Math.floor(dias/7)+1;

if(semana>52)
semana=52;

return semana;

}


/* =====================================================
FASE
===================================================== */

function obterFase(semana){

return fases.find(
fase=>
semana>=fase.inicio &&
semana<=fase.fim
);

}


/* =====================================================
TREINO HOJE
===================================================== */

function treinoHoje(){

const semana=
calcularSemana();

if(!semana)
return "Descanso";

const dia=
new Date().getDay();

if(
!dados.plano.diasTreino.includes(dia)
){

return "Descanso";

}

return dados.plano.proximoTreino;

}


